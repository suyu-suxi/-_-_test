/* 顶部图片 */
.head {
  position: relative;
  width: 750rpx;
  height: 1000rpx;
}

.img {
  position: absolute;
  width: 100%;
  height: 100%;
  z-index: -1;
}

/* 使用 ::after 伪元素实现底部渐变 */
.img::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 5%; /* 调整这个值来控制渐变区域的高度 */
  background: linear-gradient(to bottom, rgba(255, 255, 255, 0) 0%, rgba(255, 255, 255, 1) 100%);
}

