/*按钮2*/

/* 按钮2按钮 */
.popup-trigger-button {
  width: 240rpx; /* 按钮宽度 */
  height: 80rpx; /* 按钮高度 */
  background-color: #ff5e00; /* 背景色 */
  color: #fff; /* 文字颜色 */
  font-size: 32rpx; /* 文字大小 */
  border-radius: 40rpx; /* 圆角，使按钮更圆润 */
  box-shadow: 0 4rpx 10rpx rgb(255, 94, 0); /* 阴影 */
  border: none; /* 去掉边框 */
  transition: background-color 0.3s ease, transform 0.2s ease; /* 过渡效果 */
  display: flex;
  justify-content: center;
  align-items: center;
}

/* 按钮点击效果 */
.popup-trigger-button:hover {
  background-color: #ff4800; /* 点击时背景色变深 */
  transform: scale(0.98); /* 点击时按钮稍微缩小 */
}
/* 弹窗容器 */
.popup-container {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 999;
}

/* 遮罩层 */
.popup-mask {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.5);
}

/* 弹窗内容 */
.popup-content {
  position: relative;
  width: 80%;
  background-color: #fff;
  border-radius: 20rpx;
  padding: 20rpx;
  box-sizing: border-box;
  text-align: center;
  z-index: 1000;
}

/* 弹窗图片 */
.popup-image {
  width: 100%;
  height: 400rpx;
  border-radius: 10rpx;
}

/* 关闭按钮 */
.popup-content button {
  margin-top: 20rpx;
  width: 200rpx; /* 按钮宽度 */
  height: 80rpx; /* 按钮高度 */
  background-color: #ff5e00; /* 背景色 */
  color: #fff; /* 文字颜色 */
  font-size: 32rpx; /* 文字大小 */
  border-radius: 40rpx; /* 圆角 */
  box-shadow: 0 4rpx 10rpx rgb(255, 94, 0); /* 阴影 */
  border: none; /* 去掉边框 */
  transition: background-color 0.3s ease; /* 背景色过渡效果 */
}

/* 按钮点击效果 */
.popup-content button:hover {
  background-color: #ff5e00; /* 点击时背景色变深 */
}