/* pages/us/us.wxss */
/* 页面整体样式 */

.container {
  background-size: cover;
  color: #ffffff;
  font-family: '微软雅黑', sans-serif;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

/* 头部样式 */
.header {
  text-align: center;
  padding: 20px 0;
}

.company-logo {
  width: 100px;
  height: auto;
  margin: 0 auto;
  display: block;
}

.title {
  font-size: 28px;
  margin-top: 10px;
  font-weight: bold;
}

/* 内容区域样式 */
.content {
  flex: 1;
  padding: 20px;
}

.card {
  background: rgba(0, 0, 0, 0.5);
  border-radius: 10px;
  padding: 15px;
  margin-bottom: 20px;
  box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
}

.card-title {
  font-size: 22px;
  font-weight: bold;
  margin-bottom: 10px;
  text-align: center;
}

.card-text {
  font-size: 16px;
  line-height: 1.8;
  text-align: center;
}

/* 底部样式 */
.footer {
  text-align: center;
  padding: 10px 0;
}

.navigator {
  color: #ffffff;
  text-decoration: underline;
}
